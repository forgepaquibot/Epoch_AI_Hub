extends layout.pug

block styles
  link(rel='stylesheet' href='/chat_style.css')

block content
  // ============================================================
  // CHAT OVERVIEW
  // ============================================================

  header.page-heading#chat-overview(
    data-progress-section
    data-progress-label='Overview'
  )
    p.eyebrow CONVERSATIONS
    h1 Chat with an agent
    p.lead
      | Choose an agent and decide where its model should run.
      | Device-local inference is the default when the model is supported.

  if message
    p.notice(role='status' aria-live='polite')= message

  // ============================================================
  // CHAT WORKSPACE
  // ============================================================

  section.chat-workspace
    // ==========================================================
    // CHAT CONTROLS
    // ==========================================================

    section.chat-controls.panel#chat-controls-section(
      data-progress-section
      data-progress-label='Chat'
    )
      if agents.length
        form#chat-form
          label.field(for='agent_id')
            span Agent
            select#agent_id(name='agent_id' required)
              option(value='') Choose an agent
              each agent in agents
                option(
                  value=agent.agent_id
                  data-welcome-message=agent.welcome_message || ''
                  data-personality-prompt=agent.personality_prompt || ''
                  data-agent-description=agent.description || ''
                  data-model-key=agent.model_key || ''
                  data-model-metadata=agent.model_metadata_json || ''
                  data-preferred-runtime=agent.preferred_runtime_location || 'device_local'
                )= agent.name + ' — ' + agent.model_name + ' · ' + agent.owner_username

          label.field(for='runtime_location')
            span Where should the model run?
            select#runtime_location(name='runtime_location' required)
              option(value='device_local' selected) My device (default)
              option(value='server') Application server
              option(value='hosted' disabled) Hosted provider (coming later)

          p#runtime-status.form-status(
            role='status'
            aria-live='polite'
            aria-atomic='true'
          ) Choose an agent to check its runtime configuration.

          label.field(for='session_id')
            span Conversation
            select#session_id(name='session_id')
              option(value='') Start a new conversation
              each session in sessions
                option(
                  value=session.session_id
                  data-agent-id=session.agent_id
                  data-ai-id=session.agent_id
                  data-runtime-location=session.runtime_location
                )= (session.title || 'Conversation') + ' · ' + (session.updated_at || '')

          section#welcome-panel.welcome-panel(hidden aria-live='polite')
            p.eyebrow AGENT WELCOME
            p#welcome-text

          label.field(for='prompt')
            span Your message
            textarea#prompt(
              name='prompt'
              rows='5'
              maxlength='10000'
              required
              placeholder='Ask a question about your topic or resources...'
            )

          .form-actions
            button#send-message(
              type='submit'
              data-action='send'
              aria-label='Send message'
              aria-busy='false'
            ) Send message

            p#chat-status.form-status(
              role='status'
              aria-live='polite'
              aria-atomic='true'
            )

      else
        .empty-state
          h2 No active chat agents available
          p
            | Register a model and create an agent in the Model Hub
            | to start a conversation. Deprecated agents remain in
            | the Model Hub until you delete them.
          a.button(href='/ai_model') Open Model Hub

    // ==========================================================
    // CHAT RESPONSE
    // ==========================================================

    section.panel.chat-output#chat-response-section
      .panel-heading
        div
          p.eyebrow RESPONSE
          h2 Latest answer

      section#chat-response.chat-response(aria-live='polite' hidden)
        pre#answer-text
        .source-panel
          strong Retrieved sources
          p#sources-text.muted

      p#chat-empty.empty-copy
        | Select an agent and send a message to see its response here.

  // ============================================================
  // CONVERSATION HISTORY
  // ============================================================

  section.panel#conversation-history-section(
    data-progress-section
    data-progress-label='History'
  )
    .panel-heading
      div
        p.eyebrow HISTORY
        h2 Recent conversations

    if sessions.length
      .conversation-list
        each session in sessions
          article.conversation-item
            div
              strong= session.title || 'Untitled conversation'
              p.muted= session.agent_name || 'Agent'
              p.muted= session.updated_at || ''

            button.button.secondary(
              type='button'
              data-load-session=session.session_id
              data-agent-id=session.agent_id
              data-ai-id=session.agent_id
              data-runtime-location=session.runtime_location
            ) Continue

            form(
              action='/chat/sessions/' + session.session_id + '/delete'
              method='post'
              onsubmit="return confirm('Delete this conversation and all its messages? This cannot be undone.');"
            )
              button.button.secondary(type='submit') Delete
    else
      p.empty-copy
        | Your saved conversations will appear here after your first message.

block scripts
  script(type='module' src='/chat.js' defer)