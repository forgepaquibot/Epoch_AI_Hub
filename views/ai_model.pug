extends layout.pug

block styles
  link(rel='stylesheet' href='/ai_model_style.css')

block content
  // ============================================================
  // EPOCH — AI CONTROL CENTER
  // ============================================================

  header.page-heading#ai-model-overview(
    data-progress-section
    data-progress-label='Overview'
  )
    p.eyebrow EPOCH // AI CONTROL CENTER
    h1 AI Model Hub
    p.lead
      | Register models from supported runtimes, create agents with
      | individual personalities, and connect knowledge resources
      | for retrieval-augmented generation.

  if message
    p.notice(role='status' aria-live='polite')= message

  // ============================================================
  // 1. REGISTER AN OLLAMA MODEL AND CREATE AN AGENT
  // ============================================================

  section.panel#ollama-registration-section(
    data-progress-section
    data-progress-label='Ollama'
  )
    .panel-heading
      div
        p.eyebrow 01 // SERVER INFERENCE
        h2 Register an installed Ollama model
        p.muted
          | Connect a model installed on the application server and
          | create an agent that uses it. Customize the agent's
          | personality independently of the underlying model.

    if ollamaModels.length
      form(action='/register_ollama_model' method='post')
        .form-grid
          label.field(for='installed-model')
            span Installed Ollama model
            select#installed-model(name='model_ref' required)
              option(value='') Choose a model
              each model in ollamaModels
                option(value=model.name || model.model)= model.name || model.model

          label.field(for='registered-model-name')
            span Agent name
            input#registered-model-name(
              type='text'
              name='name'
              maxlength='200'
              placeholder='e.g. Study Buddy'
              required
            )

          label.field.full-width(for='registered-model-description')
            span Agent description
            input#registered-model-description(
              type='text'
              name='description'
              maxlength='2000'
              placeholder='What is this agent intended for?'
            )

        label.checkbox-label(for='ollama-agent-public')
          input#ollama-agent-public(
            type='checkbox'
            name='is_public'
            value='1'
          )
          span Make this agent public to other signed-in users

        .form-actions
          button(type='submit') Register model and create agent
    else
      .empty-state
        h3 No Ollama models found
        p
          | The application could not find installed Ollama chat models.
          | Start Ollama and install a compatible model on the server
          | before registering one here.

  // ============================================================
  // 2. REGISTER A WEBLLM MODEL AND CREATE AN AGENT
  // ============================================================

  section.panel#webllm-registration-section(
    data-progress-section
    data-progress-label='WebLLM'
  )
    .panel-heading
      div
        p.eyebrow 02 // BROWSER INFERENCE
        h2 Register a WebLLM model
        p.muted
          | Register a supported browser-model identifier. Inference
          | runs in the user's browser when the environment is compatible.
          | An Ollama model name is not automatically a WebLLM identifier.

    form#register-webllm-form(
      action='/register_webllm_model'
      method='post'
    )
      .form-grid
        label.field(for='webllm-model-id')
          span WebLLM model ID
          input#webllm-model-id(
            type='text'
            name='webllm_model_id'
            maxlength='240'
            required
            placeholder='Exact ID from the WebLLM catalog'
          )

        label.field(for='webllm-model-name')
          span Model display name
          input#webllm-model-name(
            type='text'
            name='model_name'
            maxlength='200'
            required
            placeholder='e.g. Browser Language Model'
          )

        label.field.full-width(for='webllm-model-description')
          span Model description
          input#webllm-model-description(
            type='text'
            name='model_description'
            maxlength='2000'
            placeholder='Optional description of the underlying model'
          )

        label.field(for='webllm-agent-name')
          span Agent name
          input#webllm-agent-name(
            type='text'
            name='agent_name'
            maxlength='200'
            required
            placeholder='e.g. Local Study Buddy'
          )

        label.field(for='webllm-agent-description')
          span Agent description
          input#webllm-agent-description(
            type='text'
            name='description'
            maxlength='2000'
            placeholder='What should this agent help with?'
          )

        label.field.full-width(for='webllm-personality')
          span Personality instructions
          textarea#webllm-personality(
            name='personality_prompt'
            rows='4'
            maxlength='12000'
            placeholder='Describe the agent personality and response style.'
          )

        label.field.full-width(for='webllm-welcome')
          span Welcome message
          input#webllm-welcome(
            type='text'
            name='welcome_message'
            maxlength='2000'
            placeholder='Optional greeting shown when opening the agent'
          )

      label.checkbox-label(for='webllm-agent-public')
        input#webllm-agent-public(
          type='checkbox'
          name='is_public'
          value='1'
        )
        span Make this agent public to other signed-in users

      .form-actions
        button(type='submit') Register browser model and create agent

      p.muted
        | The browser will check WebGPU availability and verify the
        | configured model against the supported WebLLM catalog when
        | you chat. The first model load may require a large download.

  // ============================================================
  // 3. REGISTERED MODEL CATALOG
  // ============================================================

  section.panel#model-catalog-section(
    data-progress-section
    data-progress-label='Model Catalog'
  )
    .panel-heading
      div
        p.eyebrow 03 // MODEL CATALOG
        h2 Registered models
        p.muted
          | Explore the underlying models connected to Epoch. Models
          | can be reused by multiple agents and may have deployments
          | through different compatible runtimes.

    if registeredModels.length
      .model-grid
        each model in registeredModels
          article.model-card
            .card-topline
              span.model-provider= model.model_format || model.model_family || 'Model'

              span.visibility(
                class=model.has_enabled_deployment ? 'public' : 'private'
              )= model.has_enabled_deployment ? 'Deployment configured' : 'No enabled deployment'

            h3= model.name
            p.model-reference= model.model_key
            p= model.description || 'No model description provided.'
            p.muted Registered by #{model.owner_username || 'Unknown'}

            if model.model_origin === 'fine_tuned'
              p.muted Fine-tuned model

            p.muted= 'Model ID: ' + model.model_id

            if Number(model.user_id) === Number(currentUserId)
              form.model-card-actions(
                action='/catalog/models/' + model.model_id + '/unregister'
                method='post'
                onsubmit="return confirm('Unregister this model? Its dependent agents will become deprecated and unavailable. You can register the model again later.');"
              )
                button.button.secondary.unregister-button(
                  type='submit'
                  aria-label='Unregister model'
                  title='Unregister model'
                )
                  img(src='/unregister_icon.png' alt='')
    else
      .empty-state
        h3 No registered models
        p Register an Ollama or WebLLM model to start building your agent catalog.

  // ============================================================
  // 4. CREATE ANOTHER AGENT FROM AN EXISTING MODEL
  // ============================================================

  section.panel#agent-creation-section(
    data-progress-section
    data-progress-label='Create Agent'
  )
    .panel-heading
      div
        p.eyebrow 04 // AGENT CONFIGURATION
        h2 Create another agent
        p.muted
          | Build a different assistant from an existing model.
          | Each agent can have its own personality, welcome message,
          | visibility, and preferred runtime.

    if registeredModels.length
      form#new-agent-form(
        action='/agents/create'
        method='post'
      )
        .form-grid
          label.field(for='new-agent-model')
            span Underlying model
            select#new-agent-model(name='model_id' required)
              option(value='') Choose a registered model
              each model in registeredModels
                option(
                  value=model.model_id
                  data-model-key=model.model_key
                )= model.name + ' — ' + model.model_key

          label.field(for='new-agent-name')
            span Agent name
            input#new-agent-name(
              type='text'
              name='name'
              maxlength='200'
              required
              placeholder='e.g. Coding Tutor'
            )

          label.field.full-width(for='new-agent-description')
            span Description
            input#new-agent-description(
              type='text'
              name='description'
              maxlength='2000'
              placeholder='What is this agent intended for?'
            )

          label.field.full-width(for='new-agent-personality')
            span Personality instructions
            textarea#new-agent-personality(
              name='personality_prompt'
              rows='4'
              maxlength='12000'
              placeholder='Describe how this agent should behave.'
            )

          label.field.full-width(for='new-agent-welcome')
            span Welcome message
            input#new-agent-welcome(
              type='text'
              name='welcome_message'
              maxlength='2000'
              placeholder='Optional initial greeting'
            )

          label.field(for='new-agent-runtime')
            span Preferred runtime
            select#new-agent-runtime(name='preferred_runtime_location')
              option(value='device_local' selected) User's device (default)
              option(value='server') Application server
              option(value='hosted' disabled) Hosted provider (coming later)

        label.checkbox-label(for='new-agent-public')
          input#new-agent-public(
            type='checkbox'
            name='is_public'
            value='1'
          )
          span Make this agent public to other signed-in users

        .form-actions
          button(type='submit') Create agent
    else
      p.empty-copy Register a model before creating additional agents.

  // ============================================================
  // 5. AGENT CATALOG
  // ============================================================

  section.panel#agent-catalog-section(
    data-progress-section
    data-progress-label='Agent Catalog'
  )
    .panel-heading
      div
        p.eyebrow 05 // YOUR AI AGENTS
        h2 Registered agents
        p.muted
          | Manage your assistants and explore agents available to you.
          | Each agent maintains its own settings and resource links,
          | even when multiple agents use the same underlying model.

    if agents.length
      .model-grid
        each agent in agents
          article.model-card
            .card-topline
              span.model-provider= agent.provider == 'unknown' ? agent.model_format : agent.provider

              if Number(agent.is_deprecated) === 1
                span.status.status-disabled Deprecated
              else
                span.visibility(
                  class=agent.is_public ? 'public' : 'private'
                )= agent.is_public ? 'Public' : 'Private'

            h3= agent.name
            p.model-reference= agent.model_name || agent.model_key
            p= agent.description || 'No agent description provided.'

            if Number(agent.is_deprecated) === 1
              p.muted This agent is deprecated and cannot be used.
            else
              p.muted= 'Preferred runtime: ' + (agent.preferred_runtime_location || 'device_local')
              p.muted Created by #{agent.owner_username || 'Unknown'}

            .card-actions
              if Number(agent.is_deprecated) !== 1
                a.button(href='/models/' + agent.agent_id) Agent settings
                a.button.secondary(
                  href='/chat?agent_id=' + agent.agent_id + '&runtime_location=' + encodeURIComponent(agent.preferred_runtime_location || 'device_local')
                ) Chat

              if Number(agent.user_id) === Number(currentUserId)
                form.agent-delete-form(
                  action='/agents/' + agent.agent_id + '/delete'
                  method='post'
                  onsubmit="return confirm('Delete this agent and its conversation history? The underlying model will remain. This cannot be undone.');"
                )
                  button.button.secondary.agent-delete-button(
                    type='submit'
                    aria-label='Delete agent'
                    title='Delete agent'
                  )
                    img(src='/trash_icon.png' alt='')
    else
      .empty-state
        h3 No agents created yet
        p Register a model and create your first agent to get started.

  // ============================================================
  // 6. RESOURCE INDEXING AND AGENT RESOURCE LINKS
  // ============================================================

  section.panel#rag-panel(
    data-progress-section
    data-progress-label='Knowledge Integration'
  )
    .panel-heading
      div
        p.eyebrow 06 // KNOWLEDGE INTEGRATION
        h2 Process a resource
        p.muted
          | Indexing extracts content and builds embeddings for retrieval.
          | This is separate from fine-tuning model weights. Indexed
          | resources are linked to agents rather than directly to models.

    if activeAgents.length && ownedResources.length
      form#process-resource-form(
        action='/process_resource'
        method='post'
      )
        .form-grid
          label.field(for='process-agent')
            span Agent
            select#process-agent(name='agent_id' required)
              option(value='') Choose an agent
              each agent in activeAgents
                option(value=agent.agent_id)= agent.name + ' — ' + (agent.model_name || agent.model_key)

          label.field(for='process-resource')
            span Resource you own
            select#process-resource(name='resource_id' required)
              option(value='') Choose a resource
              each resource in ownedResources
                option(value=resource.resource_id)= resource.title + ' [' + (resource.processing_status || 'uploaded') + ']'

        .form-actions
          button(type='submit') Index and link resource
          p#processing-status.form-status(
            role='status'
            aria-live='polite'
          )

    else
      p.empty-copy
        | Create an active agent and upload a resource to begin indexing.

    if activeAgents.length && readyResources.length
      .metadata-panel
        p.eyebrow EXISTING KNOWLEDGE
        h3 Link an already indexed resource
        p.muted
          | Connect a resource that's already indexed without processing it again.

        form(action='/link_resource' method='post')
          .form-grid
            label.field(for='link-agent')
              span Agent
              select#link-agent(name='agent_id' required)
                option(value='') Choose an agent
                each agent in activeAgents
                  option(value=agent.agent_id)= agent.name + ' — ' + (agent.model_name || agent.model_key)

            label.field(for='link-resource')
              span Ready resource
              select#link-resource(name='resource_id' required)
                option(value='') Choose a ready resource
                each resource in readyResources
                  option(value=resource.resource_id)= resource.title

          button(type='submit') Link resource

  // ============================================================
  // 7. RESOURCE PROCESSING ACTIVITY
  // ============================================================

  section.panel#resource-processing-activity(
    data-progress-section
    data-progress-label='Indexing Activity'
  )
    .panel-heading
      div
        p.eyebrow 07 // SYSTEM ACTIVITY
        h2 Recent indexing jobs
        p.muted
          | Monitor resource extraction, validation, and indexing.
          | Job statuses and progress refresh automatically.

    form.job-history-actions(
      action='/resource-processing/jobs/clear-history'
      method='post'
      onsubmit="return confirm('Clear completed, failed, and cancelled indexing jobs from your history? Pending and running jobs will remain. Resources and indexed content will not be deleted.');"
    )
      button.button.secondary.clear-history-button(
        type='submit'
        aria-label='Clear indexing history'
        title='Clear history'
      )
        img(src='/clear_history_icon.png' alt='')

    .table-wrap
      table
        thead
          tr
            th Resource
            th Operation
            th Status
            th Progress
            th Started

        tbody#resource-processing-history-body
          if processingJobs.length
            each job in processingJobs
              tr
                td= job.resource_title
                td= job.operation
                td
                  span.status(class='status-' + job.status)= job.status
                td= (job.progress_percent || 0) + '%'
                td= job.started_at || job.created_at || '—'

    p#resource-processing-history-empty.empty-copy(
      hidden=processingJobs.length > 0
    ) No indexing jobs yet.

  // ============================================================
  // 8. FINE-TUNING
  // ============================================================

  section.note-strip#fine-tuning-info
    div
      p.eyebrow MODEL TRAINING
      h2 Fine-tuning is a separate process
      p
        | Resource indexing makes reference material searchable during chat.
        | Fine-tuning uses a separate training pipeline to update model weights.

    a.button.secondary(href='/training') View training catalog

block scripts
  script(src='/ai_model.js' defer)